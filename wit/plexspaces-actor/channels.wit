// PlexSpaces Actor Interface - Channels
//
// Channel abstraction for both queue (work distribution) and pub/sub (broadcast) patterns.
// Consistent with proto/plexspaces/v1/channel/channel.proto terminology.
//
// ## Design
// A "channel" is the unified concept — the same API serves:
//   - Queue semantics: send → one consumer receives (channel-send / channel-receive)
//   - Pub/sub semantics: publish → all subscribers receive (channel-publish / subscribe)
//
// Provider selection (InMemory, SQLite, Redis, Kafka, NATS, …) is a runtime concern
// resolved by the host via ServiceLocator; WASM actors use this interface without
// knowing which provider is active.
//
// ## Context parameter
// `ctx` is a JSON-encoded string carrying optional tenant/namespace override and auth
// headers (e.g. `{"tenant_id":"t1","namespace":"app","headers":{}}`).  An empty string
// is valid — the host infers tenant context from the calling actor's identity.
// Using a plain `string` (not the `context` record) ensures canonical ABI
// compatibility with all polyglot SDKs (Go/TinyGo, Python, TypeScript).

interface channels {
    use types.{payload, message-id, duration-ms, actor-error};

    /// Message received from a channel
    record channel-message {
        /// Unique message ID (ULID)
        id: message-id,
        /// Message type for routing / filtering
        msg-type: string,
        /// Message payload
        payload: payload,
        /// Unix timestamp (milliseconds) when the message was enqueued
        timestamp: u64,
        /// Number of delivery attempts (1 = first delivery)
        delivery-count: u32,
        /// Custom metadata headers
        headers: list<tuple<string, string>>,
    }

    // -------------------------------------------------------------------------
    // Queue operations (point-to-point, load-balanced to one consumer)
    // -------------------------------------------------------------------------

    /// Send a message to a channel (queue semantics — one consumer receives it).
    ///
    /// # Arguments
    /// - `ctx`:          JSON context string (tenant / namespace override; empty = actor default)
    /// - `channel-name`: Target channel name
    /// - `msg-type`:     Message type for routing / filtering
    /// - `payload`:      Message body
    ///
    /// # Returns
    /// `ok(message-id)` on success; the ID can be used with `channel-ack` / `channel-nack`.
    channel-send: func(
        ctx: string,
        channel-name: string,
        msg-type: string,
        payload: payload
    ) -> result<message-id, actor-error>;

    /// Send with extended options.
    ///
    /// # Arguments
    /// - `delay-ms`:  Delay before the message becomes visible (0 = immediate)
    /// - `ttl-ms`:    Time-to-live in milliseconds (0 = no expiry)
    /// - `headers`:   Additional metadata headers as JSON object string
    channel-send-with-options: func(
        ctx: string,
        channel-name: string,
        msg-type: string,
        payload: payload,
        delay-ms: duration-ms,
        ttl-ms: duration-ms,
        headers: string
    ) -> result<message-id, actor-error>;

    /// Receive one message from a channel (blocking until available or timeout).
    ///
    /// The returned message is "leased" — it will be redelivered if not acked within
    /// the visibility timeout. Call `channel-ack` after successful processing.
    ///
    /// # Arguments
    /// - `timeout-ms`: Maximum wait time (0 = non-blocking poll, return immediately)
    ///
    /// # Returns
    /// `ok(some(message))` on receipt; `ok(none)` on timeout / empty channel.
    channel-receive: func(
        ctx: string,
        channel-name: string,
        timeout-ms: duration-ms
    ) -> result<option<channel-message>, actor-error>;

    // -------------------------------------------------------------------------
    // Pub/sub operations (broadcast — all subscribers receive)
    // -------------------------------------------------------------------------

    /// Publish a message to a channel (pub/sub semantics — all subscribers receive it).
    ///
    /// # Returns
    /// `ok(message-id)` on success.
    channel-publish: func(
        ctx: string,
        channel-name: string,
        msg-type: string,
        payload: payload
    ) -> result<message-id, actor-error>;

    /// Subscribe to a channel (pub/sub — each subscriber gets every published message).
    ///
    /// # Arguments
    /// - `filter`: Message-type filter pattern (e.g. "order.*"); empty string = all messages
    ///
    /// # Returns
    /// Subscription ID (string ULID) used with `channel-unsubscribe`.
    channel-subscribe: func(
        ctx: string,
        channel-name: string,
        filter: string
    ) -> result<string, actor-error>;

    /// Unsubscribe from a channel.
    channel-unsubscribe: func(subscription-id: string) -> result<_, actor-error>;

    // -------------------------------------------------------------------------
    // Acknowledgement (for at-least-once delivery)
    // -------------------------------------------------------------------------

    /// Acknowledge successful message processing.
    ///
    /// Permanently removes the message from the channel (no redelivery).
    /// Must be called after `channel-receive` when processing succeeds.
    channel-ack: func(
        ctx: string,
        channel-name: string,
        message-id: message-id
    ) -> result<_, actor-error>;

    /// Negative-acknowledge (reject) a message.
    ///
    /// # Arguments
    /// - `requeue`: `true` = return to channel for retry; `false` = send to dead-letter channel
    channel-nack: func(
        ctx: string,
        channel-name: string,
        message-id: message-id,
        requeue: bool
    ) -> result<_, actor-error>;

    // -------------------------------------------------------------------------
    // Channel lifecycle
    // -------------------------------------------------------------------------

    /// Create a channel if it does not exist.
    ///
    /// # Arguments
    /// - `max-size`:        Capacity limit (0 = unbounded)
    /// - `message-ttl-ms`:  Default TTL for messages (0 = no expiry)
    channel-create: func(
        ctx: string,
        channel-name: string,
        max-size: u32,
        message-ttl-ms: duration-ms
    ) -> result<_, actor-error>;

    /// Delete a channel and all its pending messages.
    channel-delete: func(ctx: string, channel-name: string) -> result<_, actor-error>;

    /// Return the number of pending (unacked) messages in a channel.
    channel-depth: func(ctx: string, channel-name: string) -> result<u64, actor-error>;
}
