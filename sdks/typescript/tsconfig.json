{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": false
  },
  "include": ["src/**/*.ts", "src/generated/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
