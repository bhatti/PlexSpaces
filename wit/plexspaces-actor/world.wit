// PlexSpaces Actor Interface - World Definition
//
// This is the main entry point for the WIT package.
// All interfaces in the same directory are automatically included.

package plexspaces:actor@0.1.0;

/// Full-featured actor world with all capabilities
world plexspaces-actor {
    // Host-provided interfaces (imports)
    import logging;
    import messaging;
    import tuplespace;
    import channels;
    import durability;
    import workflow;
    import blob;
    import keyvalue;
    import process-groups;
    import locks;
    import registry;
    
    // Actor-implemented interfaces (exports)
    export native-actor;
}

/// Polyglot deployable actor world used by Rust/Python/Go/TypeScript SDKs.
world actor-world {
    import host-logging;
    import host-actor;
    import host-kv;
    import host-ts;
    import host-locks;
    import host-blob;
    import host-pool;
    import host-shard;
    import host-http;
    import channels;
    import registry;
    export actor;
}
