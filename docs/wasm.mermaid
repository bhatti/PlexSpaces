graph LR
    %% Node Definitions
    SC["<b>Source Code</b><br/>(Rust, Go, Python, TS)"]
    CF["<b>Compiler Frontend</b><br/>(rustc, tinygo, jco,<br/>componentize-py)"]
    IR["<b>Intermediate Rep.</b><br/>(LLVM IR, MIR,<br/>Binaryen IR)"]
    WB["<b>WASM Bytecode</b><br/>(.wasm binary<br/>~100KB-40MB)"]
    RT["<b>Runtime</b><br/>(JIT/AOT via<br/>wasmtime, wasmer)"]

    %% Connections
    SC --> CF --> IR --> WB --> RT

    %% High-Contrast Styling
    classDef source fill:#FFD700,stroke:#333,stroke-width:2px,color:#000
    classDef frontend fill:#00CCFF,stroke:#333,stroke-width:2px,color:#000
    classDef intermediate fill:#FF66B2,stroke:#333,stroke-width:2px,color:#000
    classDef bytecode fill:#33FF99,stroke:#333,stroke-width:2px,color:#000
    classDef runtime fill:#FF5733,stroke:#333,stroke-width:2px,color:#000

    class SC source
    class CF frontend
    class IR intermediate
    class WB bytecode
    class RT runtime
