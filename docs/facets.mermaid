    style Me fill:#ea580c,stroke:#fb923c,stroke-width:2px,color:#fff
    style D fill:#7c3aed,stroke:#a78bfa,stroke-width:2px,color:#fff
    style A fill:#10b981,stroke:#34d399,stroke-width:2px,color:#000
