// PlexSpaces Actor Interface - Object Registry
//
// Unified registration and discovery for all distributed objects in PlexSpaces:
// - Actors: Stateful computation units (actor model)
// - TupleSpaces: Coordination primitives (Linda model)
// - Services: Microservices and gRPC endpoints
//
// All functions use `payload = list<u8>` for structured input/output (JSON-encoded).
// This keeps flat param counts below the canonical-ABI indirect-lowering threshold (16)
// and aligns all SDK languages on the same wire format.

interface registry {
    use types.{payload, actor-error};

    /// Register an object (actor, tuplespace, or service).
    ///
    /// `request` is a JSON-encoded object with fields:
    ///   object_id: string, object_type: string, grpc_address: string,
    ///   object_category?: string, capabilities?: string[], labels?: {key,value}[],
    ///   tenant_id?: string, namespace?: string, alias?: string
    register: func(request: payload) -> result<_, actor-error>;

    /// Unregister an object.
    ///
    /// `request` is a JSON-encoded object with fields:
    ///   object_type: string, object_id: string,
    ///   tenant_id?: string, namespace?: string
    unregister: func(request: payload) -> result<_, actor-error>;

    /// Lookup a specific object by ID.
    ///
    /// `request` is a JSON-encoded object with fields:
    ///   object_type: string, object_id: string,
    ///   tenant_id?: string, namespace?: string
    ///
    /// Returns JSON-encoded `object-registration` or null if not found.
    lookup: func(request: payload) -> result<payload, actor-error>;

    /// Discover objects with optional filtering.
    ///
    /// `request` is a JSON-encoded object with optional fields:
    ///   object_type?: string, object_category?: string,
    ///   capabilities?: string[], labels?: string[],
    ///   health_status?: string, offset?: u32, limit?: u32,
    ///   tenant_id?: string, namespace?: string
    ///
    /// Returns JSON-encoded array of `object-registration`.
    discover: func(request: payload) -> result<payload, actor-error>;

    /// Update the heartbeat for a registered object.
    ///
    /// `request` is a JSON-encoded object with fields:
    ///   object_type: string, object_id: string,
    ///   tenant_id?: string, namespace?: string
    heartbeat: func(request: payload) -> result<_, actor-error>;

    /// Lookup an object by alias (Orleans grain directory pattern).
    ///
    /// `alias` format: "{actor_type}:{name}:{namespace}:{tenant_id}"
    ///
    /// Returns JSON-encoded `object-registration` or null if not found.
    lookup-by-alias: func(alias: string) -> result<payload, actor-error>;
}
