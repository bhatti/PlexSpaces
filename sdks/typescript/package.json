{
  "name": "@plexspaces/sdk",
  "version": "0.1.9",
  "description": "PlexSpaces TypeScript SDK - build actors with minimal boilerplate (inheritance-based)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run generate:types && tsc -p .",
    "generate:types": "node scripts/generate-types.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "^1.17.0",
    "typescript": "^5.0.0"
  },
  "license": "AGPL-3.0-or-later",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/plexobject/plexspaces.git",
    "directory": "sdks/typescript"
  }
}
