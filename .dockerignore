# Git files
.git
.gitignore
.gitattributes

# Documentation (not needed in Docker image)
*.md
docs/
archived_docs/
PROJECT_TRACKER.md
CLAUDE.md
.cursorrules

# Build artifacts (will be rebuilt in Docker)
target/
**/target/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Test files
**/tests/
**/*_test.rs
**/*_tests.rs

# Example apps (not needed for node binary)
examples/
!examples/rust/
!examples/rust/embedded/
!examples/rust/embedded/migrating_temporal/
!examples/rust/embedded/migrating_temporal/**

# SDKs are workspace members (needed for cargo build), but not needed at runtime
# We copy them in Dockerfile for build, but they're not included in final image

# CI/CD
.github/
.gitlab-ci.yml
.circleci/

# Temporary files
*.tmp
*.log
*.bak
*.cache

# OS files
.DS_Store
Thumbs.db

# Rust
Cargo.lock.backup
**/*.pdb

# Docker
docker-compose*.yml
Dockerfile*
.dockerignore

# Scripts (not needed in image)
scripts/
**/*.sh

# Config files that are mounted as volumes
config/release.yaml

# Note: Makefile is NOT excluded - it's needed for proto generation
