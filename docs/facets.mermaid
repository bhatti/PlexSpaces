%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#3b82f6', 'lineColor': '#94a3b8'}}}%%
graph LR
    M["📨 Message"] --> S["🔒 Security<br/>Priority 1000+"]
    S --> L["📋 Logging<br/>Priority 900"]
    L --> Me["📊 Metrics<br/>Priority 800"]
    Me --> D["🧩 Domain<br/>Priority 100-500"]
    D --> A["🎯 Actor Logic"]
    A --> P["💾 Persistence<br/>Priority 1-99"]
